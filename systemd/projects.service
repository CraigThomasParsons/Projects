[Unit]
Description=Projects Laravel Metal Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Code/ChatProjects
# Deployment policy (important):
# - ChatProjects runs on metal.
# - Do NOT run this app via Docker Compose in normal operation.
# - This avoids split-brain database confusion between host and container DBs.
ExecStart=/usr/bin/env php artisan serve --host=127.0.0.1 --port=8083
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
